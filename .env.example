# Copy this file to .env and fill in values locally. Never commit .env.

# mock (default): full demo without PayPal credentials
# live: uses the PayPal sandbox Invoicing API
PAYPAL_MODE=mock

# Sandbox REST app credentials from https://developer.paypal.com/
# Required only when PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: webhook ID from the Developer Dashboard, used to verify signatures
PAYPAL_WEBHOOK_ID=

# Sandbox Business (seller) account email shown as the invoicer
PAYPAL_INVOICER_EMAIL=seller@stallpay.example
PAYPAL_INVOICER_BUSINESS_NAME=StallPay Demo Stall
PAYPAL_INVOICER_GIVEN_NAME=Amaka
PAYPAL_INVOICER_SURNAME=Okoye

# Optional sandbox Personal (buyer) email used in live chat demos
PAYPAL_BUYER_EMAIL=buyer@stallpay.example

# Public URL of this app (needed later for webhook registration)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional model. If unset, scripted haggling and the built-in extractor
# still handle the canned demos and hold the floor.
# A Baseten-compatible key can be provided as LLM_API_KEY, BASETEN_API_KEY, or MODEL_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_MODEL=meta-models/muse-spark-open-1026
LLM_AUTH_SCHEME=Api-Key
VISION_MODEL=

# Fixed demo conversions printed on invoice notes. PayPal invoices are in USD.
NGN_PER_USD=1480.00
MXN_PER_USD=18.20
INR_PER_USD=83.50
RATE_AS_OF=10 November 2026

# SQLite path (ephemeral on most free hosts; fine for a demo)
DATABASE_PATH=data/stallpay.db
